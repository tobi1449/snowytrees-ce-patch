<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>
  <name>Snowy Trees CE Patch</name>
  <author>tobi1449</author>
  <packageId>tobi1449.snowytreescepatch</packageId>
  <supportedVersions>
    <li>1.7</li>
  </supportedVersions>
  <description>Patches tree definitions from the Snowy Trees mod for compatibility with Combat Extended, so CE ammo and penetration stats apply correctly to snowy tree plants and cover.</description>
  <modDependencies>
    <li>
      <packageId>CETeam.CombatExtended</packageId>
      <displayName>Combat Extended</displayName>
      <steamWorkshopUrl>https://steamcommunity.com/sharedfiles/filedetails/?id=2890901040</steamWorkshopUrl>
    </li>
    <li>
      <packageId>Nandonalt.SnowyTrees</packageId>
      <displayName>Snowy Trees</displayName>
      <steamWorkshopUrl>https://steamcommunity.com/sharedfiles/filedetails/?l=german&id=1322101066</steamWorkshopUrl>
    </li>
  </modDependencies>
  <loadAfter>
    <li>CETeam.CombatExtended</li>
    <li>Nandonalt.SnowyTrees</li>
  </loadAfter>
</ModMetaData>